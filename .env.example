# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Password for the /admin orders page. Pick something long.
ADMIN_PASSWORD=

# Used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# The orders database. On Vercel this must be a Turso database:
#   turso db create pammi-penji
#   turso db show pammi-penji --url      -> TURSO_DATABASE_URL
#   turso db tokens create pammi-penji   -> TURSO_AUTH_TOKEN
# Leave both empty on your own computer to use the local file ./data/pammi.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
